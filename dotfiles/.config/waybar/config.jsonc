{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 8,

  "modules-left": ["custom/workspaces", "custom/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "network", "battery"],

  "custom/workspaces": {
    "exec": "~/.config/waybar/scripts/workspaces.sh",
    "interval": 1,
    "escape": false,
    "tooltip": false,
    "on-click": "niri msg action toggle-overview"
  },

  "custom/window": {
    "exec": "~/.config/waybar/scripts/window.sh",
    "interval": 1,
    "max-length": 60
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{calendar}",
    "interval": 10
  },

  "tray": {
    "icon-size": 18,
    "spacing": 6
  },

  "network": {
    "format-wifi": "wifi {signalStrength}%",
    "format-ethernet": "eth",
    "format-disconnected": "offline",
    "tooltip-format": "{ifname} via {gwaddr}",
    "interval": 5
  },

  "battery": {
    "format": "{capacity}%",
    "states": {
      "warning": 20,
      "critical": 10
    },
    "interval": 30
  }
}
